# Matches the formatting the repository actually uses.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Jest suites, npm manifests and Markdown use two spaces.
[{__tests__/*.js,jest.config.js,*.json,*.md}]
indent_size = 2

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false
